{
  "manifest_version": 3,
  "name": "ふたつのメモ",
  "version": "1.2.0",
  "description": "すぐ書ける一時メモと、整理して残せる通常メモ。",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "ふたつのメモ",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "16": "icons/icon-16.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "16": "icons/icon-16.png",
    "128": "icons/icon-128.png"
  }
}
